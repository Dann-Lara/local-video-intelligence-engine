# Local Video Intelligence Engine — variables de entorno
# Copia a .env y ajusta. NUNCA versionar el .env real (seccion 53).
#
# Precedencia: .env / variables de entorno > config/local.yaml > config/default.yaml
# El separador de anidamiento es __ (doble guion bajo).
#
#   LVI_LLM__BASE_URL=http://192.168.1.50:1234/v1
#       -> llm.base_url

# --- Rutas ---
# ESCAPE HATCH para la ruta acentuada del proyecto (riesgo C-1).
# Si ffmpeg o remotion fallan, movelos a una ruta ASCII.
# LVI_PATHS__WORK_ROOT=C:/lvi/work
# LVI_PATHS__OUTPUT_ROOT=C:/lvi/output
# LVI_PATHS__LOGS_ROOT=C:/lvi/logs

# --- LLM local ---
# LVI_LLM__BASE_URL=http://localhost:1234/v1
# Fija el id exacto del modelo para reproducibilidad (seccion 2.4).
# Consultar el id real con: curl http://localhost:1234/v1/models
# LVI_LLM__MODEL=lmstudio-community/gemma-3-4b-it-GGUF/gemma-3-4b-it-Q4_K_M.gguf
# LVI_LLM__TEMPERATURE=0.1
# LVI_LLM__MAX_TOKENS=8192
# LVI_LLM__STRUCTURED_OUTPUT=json_schema

# --- Whisper ---
# 'cuda' si la VRAM esta libre; 'cpu' si se compite con el LLM.
# LVI_WHISPER__DEVICE=cuda
# LVI_WHISPER__MODEL=large-v3-turbo
# LVI_WHISPER__LANGUAGE=es

# --- Salida ---
# LVI_OUTPUT__VIDEO_CODEC=libx264
# LVI_OUTPUT__CRF=23

# --- Render (Remotion) ---
# Navegador para el compositor. Si no se fija, se busca Chrome/Edge del sistema.
# Fijalo si tienes varios instalados. Evita que Remotion descargue su
# Chrome Headless Shell, que necesita red.
# LVI_RENDER__BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe

# --- Base de datos ---
# LVI_ORCHESTRATION__DATABASE_URL=sqlite:///database/lvi.db

# --- API keys futuras (Phase 3) ---
# Nunca storinglas en el repo.
# LVI_YOUTUBE__API_KEY=
# LVI_YOUTUBE__CLIENT_ID=
# LVI_YOUTUBE__CLIENT_SECRET=
# LVI_TIKTOK__ACCESS_TOKEN=
# LVI_INSTAGRAM__ACCESS_TOKEN=
