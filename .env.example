# .env.example --- Local Video Studio
#
# Esta plantilla solo contiene nombres y valores de ejemplo NO sensibles.
# No colocar claves reales ni secretos en el repositorio (AGENTS.md 9).
# Copiar a .env si se necesita configuración local en fases posteriores.
#
# En la Fase 0 el proyecto no usa variables de entorno todavía; este
# archivo se crea porque el BLUEPRINT.md (Fase 0) lo lista como parte de
# la estructura mínima.

# Rutas base (relativas al repositorio). Ajustar solo si hace falta.
# NOTA (Fase 1): estas rutas aun NO se leen desde el entorno; los
# servicios usan por defecto input/ y projects/ dentro del repositorio.
# Se dejan reservadas para cuando exista un cargador de configuracion.
LVS_INPUT_DIR=input
LVS_WORK_DIR=work
LVS_PROJECTS_DIR=projects
LVS_OUTPUT_DIR=output
LVS_LOGS_DIR=logs

# Etapa A --- ingesta (services/ingestion). SI se leen desde el entorno.
# Ruta o nombre del ejecutable de FFprobe. Vacio = usar "ffprobe" del PATH.
LVS_FFPROBE_PATH=
# Segundos de espera por invocacion de FFprobe. Vacio = 30.
LVS_FFPROBE_TIMEOUT=

# Servidor de inferencia local (LM Studio). Solo 127.0.0.1 por defecto.
LVS_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LVS_LMSTUDIO_MODEL=modelo-local-de-ejemplo

# El servidor de la API debe escuchar solo en localhost.
LVS_API_HOST=127.0.0.1
LVS_API_PORT=8000
