{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video-intelligence/schemas/candidate.schema.json",
  "title": "Clip Candidate",
  "description": "Candidato a clip con su score descompuesto. Salida del Candidate Engine + Ranking Engine (secciones 18-26).",
  "type": "object",
  "required": ["schema_version", "candidate_id", "job_id", "source", "content", "hook", "score", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["file", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "start": { "type": "number", "minimum": 0.0 },
        "end": { "type": "number", "exclusiveMinimum": 0.0 },
        "duration": { "type": "number", "exclusiveMinimum": 0.0 },
        "boundary_reason": {
          "type": ["string", "null"],
          "description": "Por que empieza y termina aqui. Debe anclarse a frase/palabra completa, no a media frase (seccion 19)."
        }
      }
    },
    "original_window": {
      "type": "object",
      "description": "Ventana tal como la detecto el modelo, antes de context expansion (seccion 24).",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number", "minimum": 0.0 },
        "end": { "type": "number" },
        "duration": { "type": "number" }
      }
    },
    "expansion": {
      "type": "object",
      "description": "Registra si la ventana fue expandida y por que (seccion 24).",
      "additionalProperties": false,
      "properties": {
        "expanded": { "type": "boolean" },
        "pre_context_seconds": { "type": ["number", "null"], "minimum": 0.0 },
        "post_context_seconds": { "type": ["number", "null"], "minimum": 0.0 },
        "reason": { "type": ["string", "null"] },
        "rescored": { "type": "boolean" }
      }
    },
    "content": {
      "type": "object",
      "required": ["topic", "reason"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "reason": { "type": "string", "minLength": 1 },
        "content_type": {
          "type": "string",
          "enum": [
            "explanation",
            "story",
            "anecdote",
            "opinion",
            "tutorial",
            "list",
            "reaction",
            "interview",
            "unknown"
          ]
        },
        "transcript_excerpt": { "type": "string" }
      }
    },
    "hook": { "$ref": "content_map.schema.json#/$defs/hook" },
    "value_provided": {
      "type": "array",
      "description": "Seccion 19: el clip debe aportar al menos uno.",
      "items": {
        "type": "string",
        "enum": ["information", "emotion", "surprise", "entertainment", "conflict", "curiosity", "utility"]
      }
    },
    "progression": {
      "type": "object",
      "description": "Seccion 19: setup/desarrollo/payoff, o pregunta/tension/respuesta, o afirmacion/explicacion/conclusion.",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["setup_payoff", "question_answer", "claim_conclusion", "none"]
        },
        "beats": { "type": "array", "items": { "type": "string" } },
        "has_payoff": { "type": "boolean" },
        "ends_complete": {
          "type": "boolean",
          "description": "false = termina en medio de una frase. QC debe rechazarlo."
        }
      }
    },
    "score": { "$ref": "#/$defs/score" },
    "signatures": {
      "type": "object",
      "description": "Seccion 22: firmas para penalizar candidatos demasiado similares.",
      "additionalProperties": false,
      "properties": {
        "topic_signature": { "type": "string" },
        "semantic_signature": { "type": "string" },
        "embedding": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "description": "Vector de similitud. Opcional en el MVP; se completa en Fase 3."
        }
      }
    },
    "generated_by": { "$ref": "content_map.schema.json#/$defs/model_run" }
  },
  "$defs": {
    "score": {
      "type": "object",
      "description": "Seccion 20: 9 dimensiones con tope fijo, total 100. Los maximos se fuerzan en software, no se delegan al LLM.",
      "required": ["total", "hook", "curiosity", "value", "emotion", "narrative", "payoff", "shareability", "standalone", "visual"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number", "minimum": 0, "maximum": 100 },
        "hook": { "type": "number", "minimum": 0, "maximum": 20 },
        "curiosity": { "type": "number", "minimum": 0, "maximum": 15 },
        "value": { "type": "number", "minimum": 0, "maximum": 15 },
        "emotion": { "type": "number", "minimum": 0, "maximum": 10 },
        "narrative": { "type": "number", "minimum": 0, "maximum": 10 },
        "payoff": { "type": "number", "minimum": 0, "maximum": 10 },
        "shareability": { "type": "number", "minimum": 0, "maximum": 10 },
        "standalone": { "type": "number", "minimum": 0, "maximum": 5 },
        "visual": { "type": "number", "minimum": 0, "maximum": 5 },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confianza de la IA en su propio score."
        }
      }
    }
  }
}
