{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video-intelligence/schemas/clip_record.schema.json",
  "title": "Clip Record",
  "description": "Registro central de un clip producido (seccion 37). Debe poder responder: por que fue seleccionado y que informacion uso la IA (seccion 2.5).",
  "type": "object",
  "required": ["schema_version", "clip_id", "job_id", "source", "content", "selection", "generation", "editing", "qc", "performance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "clip_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["file", "sha256", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "start": { "type": "number", "minimum": 0.0 },
        "end": { "type": "number", "exclusiveMinimum": 0.0 },
        "duration": { "type": "number", "exclusiveMinimum": 0.0 },
        "original_duration": { "type": ["number", "null"] }
      }
    },
    "content": {
      "type": "object",
      "required": ["topic", "hook_type", "content_type"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "summary": { "type": ["string", "null"] },
        "hook_type": { "type": "string" },
        "content_type": { "type": "string" },
        "hook_origin": { "type": ["string", "null"], "enum": ["original", "generated", null] },
        "requires_generated_hook": { "type": ["boolean", "null"] },
        "value_provided": { "type": "array", "items": { "type": "string" } },
        "progression_pattern": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] }
      }
    },
    "selection": {
      "type": "object",
      "description": "Seccion 20: desglose del score. Guardar el desglose, no solo el total.",
      "required": ["score"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "hook": { "type": ["number", "null"], "minimum": 0, "maximum": 20 },
        "curiosity": { "type": ["number", "null"], "minimum": 0, "maximum": 15 },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 15 },
        "emotion": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "narrative": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "payoff": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "shareability": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "standalone": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "visual": { "type": ["number", "null"], "minimum": 0, "maximum": 5 },
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "selected_because": { "type": ["string", "null"] },
        "diversity_penalty": { "type": ["number", "null"] }
      }
    },
    "generation": {
      "type": "object",
      "required": ["model", "provider", "prompt_version"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "prompt_version": { "type": "string" },
        "transcript_model": { "type": ["string", "null"] },
        "config_hash": { "type": ["string", "null"] },
        "model_runs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "editing": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "number" },
        "subtitles": { "type": "boolean" },
        "crop_mode": { "type": ["string", "null"] },
        "renderer": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "file_sha256": { "type": ["string", "null"] },
        "render_seconds": { "type": ["number", "null"] }
      }
    },
    "qc": {
      "type": "object",
      "required": ["passed"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "technical": {
          "type": ["object", "null"],
          "properties": {
            "exists": { "type": ["boolean", "null"] },
            "duration_ok": { "type": ["boolean", "null"] },
            "resolution_ok": { "type": ["boolean", "null"] },
            "codec_ok": { "type": ["boolean", "null"] },
            "audio_present": { "type": ["boolean", "null"] },
            "video_present": { "type": ["boolean", "null"] },
            "size_bytes": { "type": ["integer", "null"] }
          },
          "additionalProperties": true
        },
        "subtitles_ok": { "type": ["boolean", "null"] },
        "semantic": {
          "type": ["object", "null"],
          "description": "Segundo LLM pass (seccion 34).",
          "properties": {
            "approved": { "type": ["boolean", "null"] },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "problems": { "type": "array", "items": { "type": "string" } },
            "recommendations": { "type": "array", "items": { "type": "string" } },
            "model": { "type": ["string", "null"] },
            "prompt_version": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "problems": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "SEO por plataforma (seccion 35). Un objeto por plataforma.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "performance": {
      "type": "array",
      "description": "Seccion 36: vacio en el MVP. Se llena cuando el clip se publica.",
      "items": { "$ref": "performance_snapshot.schema.json" }
    },
    "provenance": {
      "type": ["object", "null"],
      "description": "Trazabilidad de artefactos intermedios (seccion 77).",
      "additionalProperties": true
    }
  }
}
