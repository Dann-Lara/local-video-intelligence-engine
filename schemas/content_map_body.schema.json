{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video-intelligence/schemas/content_map_body.schema.json",
  "title": "Content Map Body",
  "description": "Lo que Gemma devuelve en la etapa BUILDING_CONTENT_MAP (seccion 17): solo el CUERPO del mapa. El envoltorio (schema_version, job_id, language, duration, generated_by) lo rellena el SOFTWARE, nunca el modelo: la atribucion de quien genero el mapa no puede venir de la propia salida del modelo (seccion 2.3: la IA propone, el software ejecuta y verifica).",
  "type": "object",
  "required": [
    "global_summary",
    "topics",
    "entities",
    "claims",
    "stories",
    "questions",
    "answers",
    "conflicts",
    "revelations",
    "surprising_points",
    "emotional_moments",
    "humorous_moments",
    "actionable_points",
    "strong_statements",
    "memorable_phrases",
    "conclusions",
    "calls_to_action",
    "topic_changes",
    "potential_hooks"
  ],
  "additionalProperties": false,
  "properties": {
    "global_summary": { "type": ["string", "null"] },
    "topics": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/topic" } },
    "entities": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/entity" } },
    "claims": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/claim" } },
    "stories": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "questions": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "answers": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "conflicts": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "revelations": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "surprising_points": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "emotional_moments": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "humorous_moments": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "actionable_points": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "strong_statements": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "memorable_phrases": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "conclusions": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "calls_to_action": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "topic_changes": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/moment" } },
    "potential_hooks": { "type": "array", "items": { "$ref": "content_map.schema.json#/$defs/hook" } }
  }
}