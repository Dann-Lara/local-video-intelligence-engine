{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-video-intelligence/schemas/edit_plan.schema.json",
  "title": "Edit Plan",
  "description": "Instruccion de render para un clip (seccion 27). Determinista: mismos parametros de entrada + mismo plan = mismo archivo de salida.",
  "type": "object",
  "required": ["schema_version", "clip_id", "job_id", "source", "output", "crop", "subtitles", "hook", "audio"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "clip_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "required": ["file", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "start": { "type": "number", "minimum": 0.0 },
        "end": { "type": "number", "exclusiveMinimum": 0.0 },
        "duration": { "type": "number", "exclusiveMinimum": 0.0 }
      }
    },
    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "video_codec", "audio_codec", "container"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "format": { "type": "string", "enum": ["9:16", "1:1", "16:9", "4:5"] },
        "video_codec": { "type": "string", "enum": ["h264_nvenc", "libx264", "hevc_nvenc"] },
        "crf": { "type": ["integer", "null"], "minimum": 0, "maximum": 51 },
        "preset": { "type": ["string", "null"] },
        "bitrate": { "type": ["string", "null"] },
        "pixel_format": { "type": ["string", "null"] },
        "audio_codec": { "type": "string", "enum": ["aac", "opus", "none"] },
        "audio_bitrate": { "type": ["string", "null"] },
        "container": { "type": "string", "enum": ["mp4", "webm", "mov", "mkv"] },
        "file": { "type": ["string", "null"] }
      }
    },
    "crop": {
      "type": "object",
      "description": "Seccion 30: el MVP usa center crop; nunca asumir que el sujeto esta en el centro.",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["center", "smart_vertical", "face_tracking", "speaker", "manual"]
        },
        "x": { "type": ["number", "null"] },
        "y": { "type": ["number", "null"] },
        "width": { "type": ["number", "null"] },
        "height": { "type": ["number", "null"] },
        "keyframe_track": { "type": "array", "items": { "type": "number" } },
        "background": { "type": "string", "enum": ["crop", "blur", "solid", "gradient"], "default": "crop" }
      }
    },
    "subtitles": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { "type": "string", "minLength": 1 },
        "language": { "type": ["string", "null"] },
        "max_words_per_line": { "type": "integer", "minimum": 1, "default": 4 },
        "max_lines": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 },
        "max_chars_per_line": { "type": ["integer", "null"], "minimum": 1 },
        "min_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "max_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "position": {
          "type": "string",
          "enum": ["lower_center", "center", "upper_center", "lower_third", "burned_in"],
          "default": "lower_center"
        },
        "renderer": { "type": "string", "enum": ["remotion", "ffmpeg_libass", "none"], "default": "remotion" }
      }
    },
    "hook": {
      "type": "object",
      "required": ["type", "origin"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "question",
            "contrarian_statement",
            "surprising_fact",
            "bold_claim",
            "conflict",
            "curiosity_gap",
            "emotional_statement",
            "story_opening",
            "unexpected_reveal",
            "none"
          ]
        },
        "origin": { "type": "string", "enum": ["original", "generated"] },
        "text": { "type": ["string", "null"] },
        "requires_generated_hook": { "type": "boolean", "default": false },
        "displayed": { "type": "boolean", "default": false },
        "integrity_note": {
          "type": ["string", "null"],
          "description": "Seccion 26: aviso de que el texto en pantalla no fue pronunciado por el creador."
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["normalize"],
      "additionalProperties": false,
      "properties": {
        "normalize": { "type": "boolean" },
        "target_lufs": { "type": ["number", "null"] },
        "true_peak_db": { "type": ["number", "null"] },
        "fade_in_seconds": { "type": "number", "minimum": 0.0, "default": 0.0 },
        "fade_out_seconds": { "type": "number", "minimum": 0.0, "default": 0.0 },
        "music": {
          "type": ["object", "null"],
          "description": "Seccion 32: musica opcional, nunca automatica si perjudica la claridad de la voz.",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "file": { "type": ["string", "null"] },
            "volume_db": { "type": ["number", "null"] },
            "duck_voice": { "type": "boolean", "default": true }
          }
        },
        "sfx": { "type": "array", "items": { "type": "object" } }
      }
    },
    "effects": { "type": "array", "items": { "type": "object" } },
    "branding": {
      "type": ["object", "null"],
      "description": "Seccion 28: branding configurable, nunca hardcodeado.",
      "additionalProperties": true
    },
    "generated_by": { "$ref": "content_map.schema.json#/$defs/model_run" }
  }
}
